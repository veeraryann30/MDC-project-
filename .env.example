# ========================================================
# Catch the Phish - Environment Configuration Template
# Copy to .env (never commit the real file).
# ========================================================

# development (default) | production
APP_ENV="development"

# JWT signing key. REQUIRED in production: a random string of 32+ characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=""

# Comma-separated browser origins allowed to call the API (no "*").
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (SQLite default; PostgreSQL compatible)
DATABASE_URL="sqlite:///./catch_the_phish.db"

# Optional limits
MAX_UPLOAD_BYTES="5242880"
RATE_LIMIT_PER_MINUTE="60"

# Threat Intelligence API Keys (Optional - the system works with local fallbacks if empty)
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
ABUSEIPDB_API_KEY=""
IPINFO_API_KEY=""

# --- Unified threat-detection engine (all optional; see docs/THREAT_INTELLIGENCE.md) ---
# Google Web Risk (Cloud console -> enable "Web Risk API" -> create an API key)
GOOGLE_WEB_RISK_API_KEY=""
# URLhaus: free Auth-Key from https://auth.abuse.ch/
URLHAUS_AUTH_KEY=""
# urlscan.io API key (https://urlscan.io/user/profile/)
URLSCAN_API_KEY=""
# Groq (Llama) key for the AI analyst (https://console.groq.com/keys) and the model to use
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Outbound call budgets per minute (defaults match each provider's free tier)
VT_REQUESTS_PER_MINUTE="4"
WEB_RISK_REQUESTS_PER_MINUTE="60"
URLHAUS_REQUESTS_PER_MINUTE="30"
URLSCAN_SEARCH_PER_MINUTE="20"
URLSCAN_SUBMIT_PER_MINUTE="5"
GROQ_REQUESTS_PER_MINUTE="20"
INTEL_CACHE_TTL_SECONDS="3600"
# Stricter per-IP limit for scan endpoints (they fan out to third-party APIs)
SCAN_RATE_LIMIT_PER_MINUTE="20"

# Frontend API base URL (set in Vercel project settings for production)
# Local FastAPI backend: http://127.0.0.1:8000/api
VITE_API_URL="http://127.0.0.1:8000/api"
